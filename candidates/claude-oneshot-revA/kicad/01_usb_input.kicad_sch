  (text "01 USB-C input, VBUS eFuse, CC controller, USB ESD" (exclude_from_sim no) (at 20.32 7.62 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "4c48ff84-242c-5b12-b825-f6c3eb2d84ad"))
  (text "Fixed UFP sink, no USB PD, 5 V only (D12/P17). TUSB320LAI in GPIO mode (D22): PORT=GND, ADDR=NC, EN_N=GND, OUT1-3 read by TCA9535." (exclude_from_sim no) (at 20.32 13.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b6d814c0-3c0a-5aa0-beda-9086d32776bc"))
  (text "TPS259474L values from docs/POWER_INPUT_EVIDENCE.md (PWR-02): RILM 1.69k, UVLO 232k/100k, OVLO 442k/100k, dVdt open. ITIMER TBD (O06): C9 DNP." (exclude_from_sim no) (at 20.32 16.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ec189db2-965a-5bb7-aedf-9600d22466e6"))
  (text "PGTH divider (R8/R9) is a candidate choice of this one-shot (same ratio as UVLO); review with O06. Shield treatment TBD: R1 0R placeholder." (exclude_from_sim no) (at 20.32 19.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e4e469cf-7947-5728-85f6-d7569bf1a5a2"))
