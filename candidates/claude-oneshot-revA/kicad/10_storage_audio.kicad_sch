  (text "10 microSD (DM3AT) on switched 3V3_SD; T5838 PDM mic on 1V8_AUDIO_SW" (exclude_from_sim no) (at 20.32 7.62 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "ef121c03-c46c-5a9f-b41f-b92c9555bf1d"))
  (text "DIG-02: SPI mode (DAT3 = SD_CS), 10k pull-ups on CMD/DAT0/DAT3 to 3V3_SD (never 3V3_MAIN), no CLK pull-up, card detect 100k to 3V3_MAIN on TCA P00, TPD4E05U06 at the socket." (exclude_from_sim no) (at 20.32 13.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e6ad9ed7-1b23-5124-82e8-c6c24dd6012f"))
  (text "AUD-01/AUD-02: 1V8_AUDIO_SW = TPS22918 branch from 1V8_LOGIC (AUD_SW_EN, pull-down). TXU0202 A1->B1Y clock, B2->A2Y data, OE 100k to 1V8_AUDIO_SW." (exclude_from_sim no) (at 20.32 16.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ad16a778-7290-548b-936a-26158f24e3da"))
  (text "T5838 SELECT=GND (DATA1/right), THSEL=GND and WAKE open (no AAD). 0.8 mm sound hole in the footprint, no paste on the port." (exclude_from_sim no) (at 20.32 19.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8cb03755-a7e4-5ee1-95ca-39b952458573"))
