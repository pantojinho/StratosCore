  (text "06 ICM-42688-P, MMC5983MA, BMP581, SHT40 on the shared 100 kHz I2C bus" (exclude_from_sim no) (at 20.32 7.62 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "7eb78eea-37ff-5349-8287-8a377370b820"))
  (text "Addresses: ICM-42688-P 0x68 (AD0=GND), MMC5983MA 0x30, BMP581 0x46 (SDO=GND, CSB=VDDIO), SHT40-AD1B 0x44. All on 3V3_MAIN." (exclude_from_sim no) (at 20.32 13.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a447dc11-a2e8-5312-90bd-3d447c47dc03"))
  (text "Placement (SNS-02): IMU near centroid >=3 mm from anchors; MMC >=15 mm from cells/inductors; BMP581+SHT40 at the top vent edge, no copper/vias under BMP581, SHT40 on a slotted thermal tab." (exclude_from_sim no) (at 20.32 16.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ca9cf800-c8af-5505-bc0c-eea9210af432"))
  (text "BMP581 INT tied to GND with interrupts disabled (repo 04_sensors sheet); MMC INT and ICM INT2 unused (polled/NC)." (exclude_from_sim no) (at 20.32 19.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c6821dd8-1fb9-5f04-96f0-57921e55c4d5"))
