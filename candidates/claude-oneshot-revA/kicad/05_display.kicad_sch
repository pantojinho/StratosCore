  (instances (project "StratosCore_Claude" (path "/228046b9-97ff-5406-9bfc-6ccddcf60c75/2dd3b7c1-6d8f-5db6-8547-d9ea89d5cabc" (reference "#PWR06019") (unit 1)))))
  (text "05 Orient AFY240320A1-2.8INTH-C1: XF3M FPC connectors, 3.3->1.8 V SPI branch, reset, backlight" (exclude_from_sim no) (at 20.32 7.62 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "4ae71977-c9a7-5d66-92d2-d983808d8fb4"))
  (text "Write-only three-line 9-bit SPI, IM2/IM1/IM0 = 1/0/1 (rev J). SN74AXC4T245: DIR high (A->B), OE pulled low (always enabled; GPIO8 is now EXP_CS_N, A5-2)." (exclude_from_sim no) (at 20.32 13.97 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d24db479-4ea5-52c3-9ab4-989ed7b19db8"))
  (text "TFT reset: TCA9535 P06 LCD_RST_CTRL (100k pull-down) -> SN74LVC1G07 open drain -> 10k to 1V8_LOGIC (DSP-02). Touch RESET = TCA9535 P07 TOUCH_RST_N, 10k pull-down (A8-2)." (exclude_from_sim no) (at 20.32 16.51 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fadd5dea-28e2-58dd-b686-2db431edec5a"))
  (text "UNUSED-PIN TIES ARE TBD (gate 3): DB17..DB0, DOTCLK/DE/VSYNC/HSYNC tied to GND; RD/WR tied high through R53/R54 0R (swap to GND if the controller spec requires)." (exclude_from_sim no) (at 20.32 19.05 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "7fe5e312-0d45-54bb-995b-3649278cb4e1"))
  (text "TFT VCC fed from 3V3_MAIN (2.4-3.6 V range) - the VDD/VDDI contradiction in the Orient drawing is still open (O01). Backlight TPS61169: RSET 2.21R -> ~92 mA." (exclude_from_sim no) (at 20.32 21.59 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "314d567b-a4d7-5c7b-ac76-b6889f75879c"))
  (embedded_fonts no)
