				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "6b7f6ccf-9c90-4e81-959d-ef97675ef37f")
	)
	(text_box "U3 is a logical 10-pin carrier, not a connector. Footprint is intentionally unset.\nBMP581 pin map (DS004-13): 1 VDDIO, 2 SCL, 3 GND, 4 SDA, 5 SDO=GND (0x46), 6 CSB=VDDIO, 7 INT=GND with interrupt disabled, 8-9 GND, 10 VDD. BIO=VDDIO; BVD=VDD. Populate R2/R3 as 0 ohm only after both rail ramps measure >=10 us; otherwise use 100/10 ohm per Figure 28."
		(exclude_from_sim no)
		(at 137.16 112.395 0.0000)
		(size 67.31 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
